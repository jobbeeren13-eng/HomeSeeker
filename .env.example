TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
ANTHROPIC_API_KEY=sk-ant-...
DATABASE_URL=./homeseeker.db
BASE_URL=https://yourdomain.com
PORT=3000

# REQUIRED, must be set to the SAME value on both Railway and Hetzner. Used to HMAC-sign the
# chat-id token embedded in Telegram alert links (proves a web request really comes from that
# Telegram user) and the /start deep-link payload. If left as the placeholder below, all signed
# tokens fail closed and every paywalled AI feature returns 403.
LINK_SECRET=changeme_set_in_env

# Optional: hard per-user daily cap on AI-generation calls, on top of the shared per-IP rate
# limit. Defaults to 50/day per user if not set.
MAX_AI_CALLS_PER_DAY=50

# Optional: email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=homeseeker@gmail.com
SMTP_PASS=your_app_password_here
FROM_EMAIL=HomeSeeker <homeseeker@gmail.com>
